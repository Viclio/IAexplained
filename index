                  <text x="115" y="30" text-anchor="middle" fill="#0e0b1a" font-weight="700" font-size="14">Diffusion — texture</text>
                  <text x="115" y="55" text-anchor="middle" fill="#0e0b1a" font-size="11" opacity="0.9">génère plusieurs vues du</text>
                  <text x="115" y="72" text-anchor="middle" fill="#0e0b1a" font-size="11" opacity="0.9">maillage puis les projette (UV)</text>
                  <!-- mini vues -->
                  <rect x="55" y="90" width="35" height="35" rx="4" fill="#0e0b1a" opacity="0.5"/>
                  <rect x="97" y="90" width="35" height="35" rx="4" fill="#0e0b1a" opacity="0.65"/>
