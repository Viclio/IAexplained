                <line x1="760" y1="135" x2="830" y2="135" stroke="#4ec9c1" stroke-width="2" marker-end="url(#arrow-3d)"/>

                <!-- Sortie -->
                <g transform="translate(830, 75)">
                  <rect x="0" y="0" width="220" height="120" rx="8" fill="#16122a" stroke="#c9a24a" stroke-width="1.5"/>
                  <text x="110" y="30" text-anchor="middle" fill="#fff" font-weight="600" font-size="13">Objet 3D texturé</text>
                  <text x="110" y="50" text-anchor="middle" class="label-mono" font-size="10">export .glb / .obj</text>
                  <polygon points="70,90 110,72 150,90 150,110 110,128 70,110" fill="none" stroke="#c9a24a" stroke-width="1.5"/>
                  <polygon points="70,90 110,72 150,90" fill="#c9a24a" opacity="0.35"/>
                </g>

                <text x="550" y="270" text-anchor="middle" class="label-muted" font-size="12">
                  Contrairement à l'approche « SDS » (voie 1), aucune optimisation itérative par angle de caméra&nbsp;:
                </text>
                <text x="550" y="290" text-anchor="middle" class="label-muted" font-size="12">
                  le maillage complet est produit en une seule passe de débruitage, en quelques secondes à quelques minutes.
                </text>

                <!-- Chronologie -->
                <g transform="translate(150, 340)">
                  <line x1="0" y1="20" x2="800" y2="20" stroke="#2f2856" stroke-width="2"/>
                  <circle cx="0" cy="20" r="5" fill="#7b6bff"/>
