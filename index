<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Comment fonctionnent les IA génératrices d'images — Une exploration technique</title>
    <meta
      name="description"
      content="Présentation didactique et détaillée du fonctionnement des IA génératrices d'images : diffusion, U-Net, CLIP, VAE, espace latent."
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&f[]=fraunces@300,400,500,600,700&f[]=jetbrains-mono@400,500&display=swap"
      rel="stylesheet"
    />
    <style>
      /* ============================================
         DESIGN TOKENS
         ============================================ */
      :root {
        --text-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
        --text-sm: clamp(0.875rem, 0.8rem + 0.35vw, 1rem);
        --text-base: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
        --text-lg: clamp(1.125rem, 1rem + 0.75vw, 1.5rem);
        --text-xl: clamp(1.5rem, 1.2rem + 1.25vw, 2.25rem);
        --text-2xl: clamp(2rem, 1.2rem + 2.5vw, 3.5rem);
        --text-3xl: clamp(2.5rem, 1rem + 4vw, 5rem);
        --text-hero: clamp(3rem, 0.5rem + 7vw, 7rem);

        --space-1: 0.25rem;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-6: 1.5rem;
        --space-8: 2rem;
        --space-10: 2.5rem;
        --space-12: 3rem;
        --space-16: 4rem;
        --space-20: 5rem;
        --space-24: 6rem;
        --space-32: 8rem;

        /* Palette — indigo profond + or chaud, inspirée de la génération d'image */
        --color-bg: #0e0b1a;
        --color-surface: #16122a;
        --color-surface-2: #1e1938;
        --color-surface-3: #251f45;
        --color-border: #2f2856;
        --color-text: #ece9f5;
        --color-text-muted: #a29fbf;
        --color-text-faint: #6e6b8a;

        --color-primary: #c9a24a; /* or chaud */
        --color-primary-soft: #f2d78a;
        --color-accent: #7b6bff; /* violet lumineux */
        --color-accent-soft: #b3a8ff;
        --color-teal: #4ec9c1;
        --color-rose: #e26d8b;

        --radius-sm: 0.375rem;
        --radius-md: 0.625rem;
        --radius-lg: 1rem;
        --radius-xl: 1.5rem;
        --radius-full: 9999px;

        --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
        --shadow-md: 0 6px 20px rgba(0, 0, 0, 0.35);
        --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.5);
        --shadow-glow: 0 0 60px rgba(123, 107, 255, 0.15);

        --content-narrow: 680px;
        --content-default: 960px;
        --content-wide: 1200px;

        --font-body: 'General Sans', 'Helvetica Neue', sans-serif;
        --font-display: 'Fraunces', Georgia, serif;
        --font-mono: 'JetBrains Mono', 'SF Mono', monospace;

        --transition: 220ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* ============================================
         BASE
         ============================================ */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        scroll-padding-top: 90px;
      }

      body {
        font-family: var(--font-body);
        font-size: var(--text-base);
        line-height: 1.65;
        color: var(--color-text);
        background: var(--color-bg);
        background-image:
          radial-gradient(1200px 800px at 10% -10%, rgba(123, 107, 255, 0.12), transparent 60%),
          radial-gradient(1000px 700px at 100% 5%, rgba(201, 162, 74, 0.08), transparent 55%),
          radial-gradient(900px 600px at 50% 100%, rgba(78, 201, 193, 0.06), transparent 60%);
        background-attachment: fixed;
        min-height: 100dvh;
      }

      img,
      picture,
      video,
      canvas,
      svg {
        display: block;
        max-width: 100%;
        height: auto;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-display);
        font-weight: 500;
        line-height: 1.1;
        letter-spacing: -0.02em;
        text-wrap: balance;
      }

      p,
      li {
        text-wrap: pretty;
      }

      a {
        color: var(--color-primary-soft);
        text-decoration: none;
        border-bottom: 1px solid rgba(242, 215, 138, 0.25);
        transition: var(--transition);
      }
      a:hover {
        color: var(--color-primary);
        border-bottom-color: var(--color-primary);
      }

      ::selection {
        background: rgba(123, 107, 255, 0.4);
        color: #fff;
      }

      /* ============================================
         LAYOUT
         ============================================ */
      .container {
        width: 100%;
        max-width: var(--content-default);
        margin: 0 auto;
        padding: 0 var(--space-6);
      }
      .container-wide {
        max-width: var(--content-wide);
      }
      .container-narrow {
        max-width: var(--content-narrow);
      }

      section {
        padding-block: clamp(var(--space-16), 8vw, var(--space-24));
        position: relative;
      }

      /* ============================================
         NAVIGATION
         ============================================ */
      .top-nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(14, 11, 26, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--color-border);
      }
      .nav-inner {
        max-width: var(--content-wide);
        margin: 0 auto;
        padding: var(--space-3) var(--space-6);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-6);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-family: var(--font-display);
        font-size: var(--text-sm);
        font-weight: 500;
        letter-spacing: -0.01em;
        border: none;
        color: var(--color-text);
      }
      .brand svg {
        width: 26px;
        height: 26px;
      }
      .toc {
        display: flex;
        gap: var(--space-4);
        flex-wrap: wrap;
        font-size: var(--text-xs);
      }
      .toc a {
        color: var(--color-text-muted);
        border-bottom: none;
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-sm);
        letter-spacing: 0.02em;
      }
      .toc a:hover {
        color: var(--color-primary-soft);
        background: rgba(255, 255, 255, 0.04);
      }
      @media (max-width: 900px) {
        .toc {
          display: none;
        }
      }

      /* ============================================
         HERO
         ============================================ */
      .hero {
        padding-block: clamp(var(--space-16), 10vw, var(--space-32));
        position: relative;
        overflow: hidden;
      }
      .hero-inner {
        max-width: var(--content-wide);
        margin: 0 auto;
        padding: 0 var(--space-6);
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        gap: var(--space-16);
        align-items: center;
      }
      @media (max-width: 900px) {
        .hero-inner {
          grid-template-columns: 1fr;
          gap: var(--space-10);
        }
      }
      .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-3);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-full);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        margin-bottom: var(--space-6);
      }
      .hero-eyebrow::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-primary);
        box-shadow: 0 0 12px var(--color-primary);
      }
      .hero h1 {
        font-size: clamp(2.5rem, 1.5rem + 3.5vw, 5rem);
        margin-bottom: var(--space-6);
      }
      .hero h1 em {
        font-style: italic;
        color: var(--color-primary-soft);
        font-weight: 400;
      }
      .hero-lede {
        font-size: var(--text-lg);
        color: var(--color-text-muted);
        max-width: 52ch;
        margin-bottom: var(--space-8);
      }
      .hero-meta {
        display: flex;
        gap: var(--space-6);
        flex-wrap: wrap;
        font-size: var(--text-xs);
        color: var(--color-text-faint);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .hero-meta span::before {
        content: '';
        display: inline-block;
        width: 24px;
        height: 1px;
        background: var(--color-border);
        vertical-align: middle;
        margin-right: var(--space-2);
      }
      .hero-image {
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-lg), var(--shadow-glow);
        border: 1px solid var(--color-border);
      }
      .hero-image img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
      }

      /* ============================================
         SECTION STRUCTURE
         ============================================ */
      .section-number {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-primary);
        letter-spacing: 0.2em;
        margin-bottom: var(--space-4);
      }
      .section-title {
        font-size: var(--text-2xl);
        margin-bottom: var(--space-4);
      }
      .section-title em {
        font-style: italic;
        color: var(--color-primary-soft);
      }
      .section-lede {
        font-size: var(--text-lg);
        color: var(--color-text-muted);
        max-width: 62ch;
        margin-bottom: var(--space-10);
      }

      h3 {
        font-size: var(--text-xl);
        margin-top: var(--space-12);
        margin-bottom: var(--space-4);
        color: var(--color-text);
      }
      h4 {
        font-size: var(--text-lg);
        margin-top: var(--space-8);
        margin-bottom: var(--space-3);
        color: var(--color-primary-soft);
        font-weight: 600;
      }

      p {
        margin-bottom: var(--space-4);
        max-width: 72ch;
      }
      p.lead {
        font-size: var(--text-lg);
        color: var(--color-text-muted);
      }
      ul,
      ol {
        margin: var(--space-4) 0 var(--space-6) var(--space-6);
        max-width: 72ch;
      }
      li {
        margin-bottom: var(--space-2);
      }
      li::marker {
        color: var(--color-primary);
      }

      strong {
        color: #fff;
        font-weight: 600;
      }
      em {
        color: var(--color-primary-soft);
      }
      code {
        font-family: var(--font-mono);
        font-size: 0.92em;
        background: var(--color-surface-2);
        color: var(--color-primary-soft);
        padding: 0.15em 0.4em;
        border-radius: var(--radius-sm);
        border: 1px solid var(--color-border);
      }

      /* ============================================
         COMPONENTS
         ============================================ */

      /* Divider */
      .divider {
        height: 1px;
        max-width: var(--content-wide);
        margin: 0 auto;
        background: linear-gradient(
          90deg,
          transparent,
          var(--color-border) 20%,
          var(--color-border) 80%,
          transparent
        );
      }

      /* Callout box */
      .callout {
        border: 1px solid var(--color-border);
        background: linear-gradient(
          180deg,
          var(--color-surface),
          var(--color-surface-2)
        );
        border-radius: var(--radius-lg);
        padding: var(--space-6) var(--space-8);
        margin: var(--space-8) 0;
        position: relative;
      }
      .callout::before {
        content: '';
        position: absolute;
        left: 0;
        top: var(--space-6);
        bottom: var(--space-6);
        width: 3px;
        background: linear-gradient(180deg, var(--color-primary), var(--color-accent));
        border-radius: var(--radius-full);
      }
      .callout-label {
        display: block;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-primary);
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin-bottom: var(--space-2);
      }
      .callout p:last-child {
        margin-bottom: 0;
      }

      /* Figure */
      figure {
        margin: var(--space-10) 0;
      }
      figure.wide {
        margin-inline: calc(50% - min(50vw, var(--content-wide) / 2) + var(--space-6));
        max-width: none;
      }
      figure img,
      figure .svg-wrap {
        border-radius: var(--radius-lg);
        border: 1px solid var(--color-border);
        overflow: hidden;
        background: var(--color-surface);
        box-shadow: var(--shadow-md);
      }
      figure .svg-wrap {
        padding: var(--space-6);
        background: linear-gradient(
          180deg,
          var(--color-surface) 0%,
          var(--color-surface-2) 100%
        );
      }
      figure .svg-wrap svg {
        width: 100%;
        height: auto;
        max-width: 100%;
      }
      figcaption {
        margin-top: var(--space-3);
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        text-align: center;
        max-width: 72ch;
        margin-inline: auto;
        line-height: 1.55;
      }
      figcaption strong {
        color: var(--color-primary-soft);
        font-weight: 500;
      }

      /* Grid layouts */
      .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-6);
        margin: var(--space-8) 0;
      }
      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-6);
        margin: var(--space-8) 0;
      }
      @media (max-width: 720px) {
        .grid-2,
        .grid-3 {
          grid-template-columns: 1fr;
        }
      }

      .card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        transition: var(--transition);
      }
      .card:hover {
        border-color: var(--color-primary);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
      }
      .card-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-md);
        background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: var(--space-4);
        font-family: var(--font-mono);
        font-weight: 600;
        color: #fff;
      }
      .card h4 {
        margin-top: 0;
        margin-bottom: var(--space-2);
        color: var(--color-text);
      }
      .card p {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        margin: 0;
      }

      /* Timeline */
      .timeline {
        position: relative;
        margin: var(--space-10) 0;
        padding-left: var(--space-8);
      }
      .timeline::before {
        content: '';
        position: absolute;
        left: 8px;
        top: 8px;
        bottom: 8px;
        width: 1px;
        background: linear-gradient(
          180deg,
          transparent,
          var(--color-border) 10%,
          var(--color-border) 90%,
          transparent
        );
      }
      .tl-item {
        position: relative;
        margin-bottom: var(--space-10);
      }
      .tl-item::before {
        content: '';
        position: absolute;
        left: -32px;
        top: 8px;
        width: 17px;
        height: 17px;
        border-radius: 50%;
        background: var(--color-bg);
        border: 2px solid var(--color-primary);
        box-shadow: 0 0 0 4px var(--color-bg), 0 0 12px rgba(201, 162, 74, 0.4);
      }
      .tl-year {
        font-family: var(--font-mono);
        color: var(--color-primary);
        font-size: var(--text-sm);
        font-weight: 500;
        letter-spacing: 0.1em;
        margin-bottom: var(--space-1);
      }
      .tl-item h4 {
        margin-top: 0;
        margin-bottom: var(--space-2);
        color: var(--color-text);
      }
      .tl-item p {
        color: var(--color-text-muted);
        font-size: var(--text-sm);
        margin: 0;
      }

      /* Comparison table */
      .table-wrap {
        overflow-x: auto;
        margin: var(--space-8) 0;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: var(--color-surface);
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-sm);
      }
      th,
      td {
        padding: var(--space-3) var(--space-4);
        text-align: left;
        border-bottom: 1px solid var(--color-border);
        vertical-align: top;
      }
      th {
        background: var(--color-surface-2);
        font-weight: 600;
        color: var(--color-primary-soft);
        font-family: var(--font-display);
        font-size: var(--text-base);
        letter-spacing: -0.01em;
      }
      tr:last-child td {
        border-bottom: none;
      }
      td:first-child {
        font-weight: 500;
        color: #fff;
      }

      /* Code block */
      pre {
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: var(--space-4) var(--space-6);
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--color-primary-soft);
        margin: var(--space-6) 0;
        line-height: 1.55;
      }
      pre code {
        background: none;
        border: none;
        padding: 0;
        color: inherit;
      }

      /* Formula box */
      .formula {
        display: flex;
        justify-content: center;
        padding: var(--space-6);
        margin: var(--space-6) 0;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        font-family: var(--font-mono);
        font-size: var(--text-base);
        color: var(--color-primary-soft);
        text-align: center;
        letter-spacing: 0.03em;
      }

      /* Footer */
      footer {
        border-top: 1px solid var(--color-border);
        padding: var(--space-12) var(--space-6);
        text-align: center;
        color: var(--color-text-faint);
        font-size: var(--text-sm);
      }
      footer p {
        max-width: none;
        margin: 0 auto var(--space-2);
      }

      /* SVG diagram styles */
      .diagram-svg {
        font-family: var(--font-body);
      }
      .diagram-svg text {
        fill: var(--color-text);
        font-size: 13px;
      }
      .diagram-svg .label-muted {
        fill: var(--color-text-muted);
        font-size: 11px;
      }
      .diagram-svg .label-mono {
        font-family: var(--font-mono);
        fill: var(--color-primary-soft);
        font-size: 11px;
      }
      .diagram-svg .label-title {
        font-family: var(--font-display);
        fill: var(--color-text);
        font-size: 14px;
        font-weight: 500;
      }

            /* Denoising simulator */
      .denoise-sim {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: var(--space-10);
        align-items: center;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: var(--space-8);
        margin: var(--space-8) 0;
      }
      @media (max-width: 720px) {
        .denoise-sim {
          grid-template-columns: 1fr;
        }
      }
      .denoise-canvas-wrap {
        position: relative;
        width: 320px;
        max-width: 100%;
        margin: 0 auto;
      }
      #denoise-canvas {
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        background: #16122a;
        display: block;
      }
      .denoise-badge {
        position: absolute;
        top: var(--space-3);
        left: var(--space-3);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background: rgba(14, 11, 26, 0.75);
        border: 1px solid var(--color-border);
        color: var(--color-primary-soft);
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-full);
        backdrop-filter: blur(6px);
      }
      .denoise-controls {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
      }
      .denoise-row {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }
      .denoise-row label {
        font-size: var(--text-xs);
        color: var(--color-text-muted);
      }
      #denoise-slider {
        width: 100%;
        accent-color: var(--color-primary);
        cursor: pointer;
      }
      .denoise-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
      }
      .denoise-btn {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        color: var(--color-text);
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: var(--space-2) var(--space-4);
        cursor: pointer;
        transition: var(--transition);
      }
      .denoise-btn:hover {
        border-color: var(--color-primary);
        transform: translateY(-1px);
      }
      .denoise-btn-primary {
        background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
        border-color: transparent;
        color: #0e0b1a;
        font-weight: 600;
      }
      .denoise-meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-5);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
      }
      .denoise-meta strong {
        color: var(--color-primary-soft);
      }

      /* Reveal on scroll */
      .reveal {
        opacity: 0;
